{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "description": "State-of-the-art Web Search Chat Agent with Multi-View Episodic Memory System & AgentBridge Governance",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && tsc --noEmit",
    "start": "NODE_ENV=production tsx server.ts",
    "cli": "tsx src/cli.ts",
    "test:eval": "tsx test/eval-harness.ts",
    "test:stress": "tsx test/stress-agent-architecture.test.ts",
    "test:security": "tsx test/security-guardrails.test.ts",
    "test:supervised": "tsx test/supervised-approval-e2e.test.ts",
    "test:auth": "tsx test/auth-sessions-timing.test.ts",
    "test:benchmark": "tsx test/benchmark.test.ts",
    "test:recall": "tsx test/autonomous-recall.test.ts",
    "test:priority": "tsx test/context-priority.test.ts",
    "test:scale": "tsx test/scale-recall-benchmark.test.ts",
    "test:tokens": "tsx test/token-usage.test.ts",
    "test:facts": "tsx test/async-fact-extractor.test.ts",
    "test:facts:live": "tsx test/live-cheap-extraction-eval.ts",
    "test": "tsx test/security-guardrails.test.ts && tsx test/stress-agent-architecture.test.ts && tsx test/auth-sessions-timing.test.ts && tsx test/benchmark.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.475.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
