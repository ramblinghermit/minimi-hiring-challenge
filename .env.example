# =================================================================
# Minimi — Environment Configuration
# =================================================================

# Server Port
PORT=3000

# -----------------------------------------------------------------
# 1. LLM Provider (Provide at least one, or use internal fallback)
# -----------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Ultra-fast inference)
GROQ_API_KEY=

# -----------------------------------------------------------------
# 2. Web Search Provider ("The One Tool")
# -----------------------------------------------------------------
# Note: If no search API key is provided, Minimi automatically activates
# its zero-config fallback searcher (DuckDuckGo scraper). It will always
# search the live web and never crash!

# Brave Search Web API (Recommended: fast, private, independent index)
BRAVE_SEARCH_API_KEY=

# Tavily Search API (Alternative: LLM-optimized deep research)
TAVILY_API_KEY=
