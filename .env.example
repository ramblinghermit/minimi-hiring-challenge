# =================================================================
# Minimi — Environment Configuration Template
# =================================================================

# Server Port
PORT=3000

# -----------------------------------------------------------------
# 1. LLM Provider (Google Gemini API or Google Cloud Vertex AI)
# -----------------------------------------------------------------
# Optional explicit provider override: 'gemini' or 'vertex'
LLM_PROVIDER=gemini

# Option A: Google Gemini API (Google AI Studio - Default)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Option B: Google Cloud Vertex AI (Service Account Key)
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json
VERTEX_PROJECT=your_gcp_project_id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 2. Web Search Provider ("The One Tool")
# -----------------------------------------------------------------
# Note: If no search API key is provided, Minimi automatically activates
# its zero-config fallback searcher (DuckDuckGo scraper). It will always
# search the live web and never crash!

# Brave Search Web API (Recommended: fast, private, independent index)
BRAVE_SEARCH_API_KEY=your_brave_api_key

